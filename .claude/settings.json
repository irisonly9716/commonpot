{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run api:lint)",
      "Bash(npm run format)",
      "Bash(npm test:*)",
      "Bash(npm run test:integration:*)",
      "Bash(npx supabase status:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git log --oneline)",
      "Bash(git log --oneline -n:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npx vitest run:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase link:*)",
      "Bash(vercel:*)",
      "Bash(git diff --no-index:*)",
      "Bash(git log -p:*)",
      "Bash(git show:*)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)"
    ]
  }
}
